{% for e in events %}
    (
        id = "{{ e.id }}",
        initial_value = {{ "true" if e.initial_value else "false" }},
        persistent = {{ "true" if e.persistent else "false" }},
        use_trigger_values = {{ "true" if e.use_trigger_values else "false" }},
        delay = {{ e.functions.delay or "nothing" }},
        priority = {{ e.functions.priority or "nothing" }},
        values = {{ e.functions["values"] }},
        assign = {{ e.functions.assign }},
    ),
{% endfor %}
]
{% else %}

