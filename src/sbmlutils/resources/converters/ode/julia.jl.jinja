const EVENTS = NamedTuple[]
{% endif %}
{% if options.simulator %}

# the limits of a simulation: the steps of the integrator beyond those which the
# largest step forces{% if events %}, and the executions of events at one time, beyond which an
# infinite cascade is probable{% endif %}

const MAX_STEPS = 100000
{% if events %}
const MAX_CASCADE = 10000

# the points of a step of the integrator at which the root functions of the triggers
# are evaluated (`interp_points` of `VectorContinuousCallback`), evenly spaced to its
# end, as in the python and the R code
const TRIGGER_POINTS = 10
{% endif %}
{% endif %}
{% if options.simulator and events %}

"""
An execution of an event which is scheduled: the index of the event in `EVENTS`, the
time of the execution and the values of its assignments from the trigger time,
`nothing` if they are evaluated at the execution.
"""
struct Execution
    event::Int
    time::Float64
    values::Union{Nothing, Vector{Float64}}
end

"""
    first_change(interpolant, t_old, t_new, p, holds)

The first time in a step of the integration at which a trigger changes.

Bisection on the solution of the step, between a time without and a time with a
change, finds the first time with a change to the rounding error: `time >= 1` changes
at t = 1. A trigger which keeps its value at its root and changes right after it,
`time > 1` at t = 1, changes at a time clearly after the root, as an integrator
locates it, so that the time stays after the root when a delay is added to it.

# Arguments
- `interpolant`: the solution of the step, the states at a time of the step
- `t_old`: the start of the step, where the triggers are `holds`
- `t_new`: the end of the step, where a trigger differs from `holds`
- `p`: the constants
- `holds`: whether each trigger holds at the start of the step
"""
function first_change(interpolant, t_old, t_new, p, holds)
    changed(t) = event_conditions(interpolant(t), p, t) != holds
    t_low, t_high = t_old, t_new
    while true
        t_middle = t_low + (t_high - t_low) / 2
        if t_middle <= t_low || t_middle >= t_high
            break
        end
        if changed(t_middle)
            t_high = t_middle
        else
            t_low = t_middle
        end
    end
    turned = event_conditions(interpolant(t_high), p, t_high) .!= holds
    if any(event_triggers(interpolant(t_low), p, t_low)[turned] .== 0)
        return min(t_new, t_low + 1e-13 * max(1.0, abs(t_low)))
    end
    return t_high
end

"""
    extrapolation(t, x, p)

The states right after the time t, extrapolated from the states x at t with their
rates of change, a function of the time.

The integrator ends a step right before a root of a trigger it finds; the change of
the trigger, at its root or right after it, is located with `first_change` on the
extrapolation.
"""
function extrapolation(t, x, p)
    dx = similar(x)
    f!(dx, x, p, t)
    return t_after -> x .+ (t_after - t) .* dx
end

"""
    execute_events(t, x, p, holds, pending)

Execute the events due at the time t.

1. A trigger which turned true schedules an execution of its event at t plus its
   delay, with the values of its assignments if it uses the values from the trigger
   time; a trigger which turned false drops the executions of its event unless it is
   persistent.
2. Of the executions due, the one of the highest priority is executed (an event
   without a priority has the priority 0), ties in the order of `EVENTS`, which SBML
   leaves to chance.
3. The triggers are evaluated with the new states and constants, repeating from step
   1 until no execution is due: an event can trigger another one or drop it. More
   than `MAX_CASCADE` executions at one time throw an error.

# Arguments
- `t`: the time
- `x`: the states
- `p`: the constants
- `holds`: whether each trigger held before t
- `pending`: the scheduled executions, a vector of `Execution` which is changed

Returns the states, the constants and whether each trigger holds, after the events.
"""
function execute_events(t, x, p, holds, pending)
    executions = 0
    while true
        holds_now = event_conditions(x, p, t)
        for (event_index, event) in enumerate(EVENTS)
            if holds_now[event_index] && !holds[event_index]
                delay_time = event.delay === nothing ? 0.0 : event.delay(x, p, t)
                values = event.use_trigger_values ? event.values(x, p, t) : nothing
                push!(pending, Execution(event_index, t + delay_time, values))
            elseif holds[event_index] && !holds_now[event_index] && !event.persistent
                # the trigger turned false, the executions of the event are dropped
                filter!(scheduled -> scheduled.event != event_index, pending)
            end
        end
        holds = holds_now

        due = findall(scheduled -> scheduled.time <= t, pending)
        if isempty(due)
            return x, p, holds
        end

        # the priority of each execution due, ties in the order of `EVENTS`
        ranks = map(due) do index
            event = EVENTS[pending[index].event]
            priority_value = event.priority === nothing ? 0.0 : event.priority(x, p, t)
            (priority_value, -pending[index].event)
        end
        execution = popat!(pending, due[argmax(ranks)])
        executions += 1
        if executions > MAX_CASCADE
            error(
                "More than $MAX_CASCADE events were executed at t = $t, the events " *
                "trigger each other in an infinite cascade.",
            )
        end
        event = EVENTS[execution.event]
        values = something(execution.values, event.values(x, p, t))
        x, p = event.assign(x, p, t, values)
    end
end
{% endif %}
{% if options.simulator %}

"""
    simulate(t_end; points=101, p=nothing, x0=nothing, reltol=1e-8, abstol=1e-10,
             alg=Rodas5P(), dtmax=nothing, max_steps=nothing)

{% if events %}
Simulate the model from t = 0 to `t_end`, with its events.

The triggers before t = 0 have their initial values, a trigger which holds at t = 0
and has the initial value false fires at t = 0. The integration stops where a trigger
changes, at the execution of a delayed event and at `t_end`; there the events are
executed, see `execute_events`, and the integration restarts with the states and
constants after them.

The integrator ends a step at each root of `event_triggers` it finds, evaluating them
at `TRIGGER_POINTS` points of each step (`interp_points` of `VectorContinuousCallback`),
and the triggers are evaluated at the end of every step, which is at most `dtmax`: a
trigger which holds for a shorter time than the distance of these points can be
stepped over.
A time point at a delayed execution, to the rounding of the time (1e-14 relative),
has the values after it: the rounding errors of the integration shift the time of
the trigger, not its integration error.
{% else %}
Simulate the model from t = 0 to `t_end`.
{% endif %}

# Arguments
- `t_end`: the end time
- `points`: the number of time points, 0 and `t_end` included
- `p`: the constants, `P0` if not given
- `x0`: the initial states, those of `initial_values` if not given
- `reltol`: the relative tolerance of the integration
- `abstol`: the absolute tolerance of the integration
- `alg`: the integrator, an algorithm of OrdinaryDiffEq, e.g. `FBDF()`
- `dtmax`: the largest step of the integrator, by default the distance of the time
  points
- `max_steps`: the largest number of steps of the integrator, by default `MAX_STEPS`
  plus twice the number of steps `dtmax` forces

{% if event_constants %}
Returns a `DataFrame` of the time, the states, the assigned values and the constants
which events change at the time points, at the time of an event the values after it.
{% elif events %}
Returns a `DataFrame` of the time, the states and the assigned values at the time
points, at the time of an event the values after it.
{% else %}
Returns a `DataFrame` of the time, the states and the assigned values at the time
points.
{% endif %}
Throws an error if the integration fails or takes more than `max_steps` steps, e.g.
when a state grows without bound{% if events %}, and for an infinite cascade of events{% endif %}.
"""
function simulate(
    t_end::Real;
    points::Integer=101,
    p::Union{Nothing, AbstractVector{<:Real}}=nothing,
    x0::Union{Nothing, AbstractVector{<:Real}}=nothing,
    reltol::Real=1e-8,
    abstol::Real=1e-10,
    alg=Rodas5P(),
    dtmax::Union{Nothing, Real}=nothing,
    max_steps::Union{Nothing, Integer}=nothing,
)
    x_initial, p = initial_values(something(p, P0))
    x = x0 === nothing ? x_initial : collect(Float64, x0)
    # the time points, a single one at t = 0
    times = points > 1 ? collect(range(0.0, Float64(t_end); length=points)) : zeros(points)
    dtmax = something(dtmax, points > 1 && t_end > 0 ? times[2] : Inf)
    max_steps = something(max_steps, MAX_STEPS + 2 * ceil(Int, t_end / dtmax))
{% if events %}
    rows = Tuple{Vector{Float64}, Vector{Float64}}[]  # the states and the constants
    steps = 0  # the steps of the integrator
    # the root functions of the triggers: the integrator ends a step at a root it finds
    at_root = Ref(false)  # whether the step ended at a root
    triggers = VectorContinuousCallback(
        (roots, x, t, integrator) -> (roots .= event_triggers(x, integrator.p, t)),
        (integrator, event_index) -> (at_root[] = true),
        length(EVENTS);
        save_positions=(false, false), interp_points=TRIGGER_POINTS,
    )

    t = 0.0
    holds = Bool[event.initial_value for event in EVENTS]
    pending = Execution[]  # the scheduled executions of the events
    x, p, holds = execute_events(t, x, p, holds, pending)
    while t < t_end
        # integrate to the next execution of a delayed event, at most to t_end
        t_stop = minimum(scheduled.time for scheduled in pending; init=Float64(t_end))
        problem = ODEProblem(f!, x, (t, t_stop), p)
        # the first step is at most the integration: OrdinaryDiffEq 7 interpolates a
        # first step which the end of the integration shortens with its full length
        integrator = init(
            problem, alg; callback=triggers, reltol, abstol,
            dtmax=min(dtmax, t_stop - t), maxiters=max_steps, save_everystep=false,
        )
        t_next, x_next = t, x  # where the integration stops
        while true
            at_root[] = false
            step!(integrator)
            steps += 1
            if !(integrator.sol.retcode in (ReturnCode.Default, ReturnCode.Success))
                error(
                    "The integration failed at t = $(integrator.t): " *
                    "$(integrator.sol.retcode)",
                )
            end
            if steps > max_steps
                error(
                    "The integration took more than $max_steps steps, at t = " *
                    "$(integrator.t).",
                )
            end
            changed = event_conditions(integrator.u, p, integrator.t) != holds
            if changed
                # the integration stops at the change of a trigger
                t_next = first_change(integrator, integrator.tprev, integrator.t, p, holds)
                x_next = integrator(t_next)
            else
                t_next, x_next = integrator.t, copy(integrator.u)
                if at_root[]
                    # the step ended right before a root, where a trigger changes at
                    # or right after it, `time > 1` at t = 1
                    beyond = extrapolation(integrator.t, x_next, p)
                    t_after = integrator.t + 1e-13 * max(1.0, abs(integrator.t))
                    if event_conditions(beyond(t_after), p, t_after) != holds
                        changed = true
                        t_next = first_change(beyond, integrator.t, t_after, p, holds)
                        x_next = beyond(t_next)
                    end
                end
            end
            # the time points of the step before t_next, at t_next after its events; a
            # time point at the end of the integration (a delayed execution) to the
            # rounding of the time is at it, the execution is shifted by the rounding
            # errors of the integration of its trigger, e.g. by 1e-14 at t = 3.4
            t_points = t_next
            if !changed && integrator.t >= t_stop
                t_points -= 1e-14 * max(1.0, abs(t_next))
            end
            while length(rows) < points && times[length(rows) + 1] < t_points
                push!(rows, (integrator(times[length(rows) + 1]), p))
            end
            if changed || integrator.t >= t_stop
                break
            end
        end
        t, x = t_next, x_next
        x, p, holds = execute_events(t, x, p, holds, pending)
    end
    # the time points at t_end, after its events
    while length(rows) < points
        push!(rows, (x, p))
    end
{% elif states %}
    rows = [(x, p) for _ in times]  # the states and the constants
    if t_end > 0
        problem = ODEProblem(f!, x, (0.0, Float64(t_end)), p)
        # the first step is at most the integration: OrdinaryDiffEq 7 interpolates a
        # first step which the end of the integration shortens with its full length
        solution = solve(
            problem, alg; saveat=times, reltol, abstol, dtmax=min(dtmax, t_end),
            maxiters=max_steps,
        )
        if solution.retcode == ReturnCode.MaxIters
            error(
                "The integration took more than $max_steps steps, at t = " *
                "$(solution.t[end]).",
            )
        elseif solution.retcode != ReturnCode.Success
            error("The integration failed at t = $(solution.t[end]): $(solution.retcode)")
        end
        rows = [(x, p) for x in solution.u]
    end
{% else %}
    # without states and events nothing changes in time but the time
    rows = [(x, p) for _ in times]  # the states and the constants
{% endif %}

    # the table: the time, the states{% if event_constants %}, the assigned values and the constants which events
    # change{% else %} and the assigned values{% endif %}

    ys = [f_y(x, p, t) for (t, (x, p)) in zip(times, rows)]
    xt = Float64[x[index] for (x, _) in rows, index in eachindex(XIDS)]
    yt = Float64[y[index] for y in ys, index in eachindex(YIDS)]
{% if event_constants %}
