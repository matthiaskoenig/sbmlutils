    columns = ["time"; XIDS; YIDS; {{ wrapped(ids, 4, 35, 1, 92) }}]
{% else %}
    data = hcat(times, xt, yt)
    columns = ["time"; XIDS; YIDS]
{% endif %}
    return DataFrame(data, columns; makeunique=true)
end
