{#- The markdown document of an ODE system, see `sbmlutils.converters.ode.documents` for the context. -#}
{#- The math is LaTeX in `$...$` and `$$...$$`, as GitHub and MathJax read it. A line of a sum after the first begins with its sign: the empty group before it spaces the sign as a binary operator. -#}
{% macro rhs(lines) %}{{ lines | join(' \\\\\n&\\quad {} ') }}{% endmacro %}
{% macro equations(rows, relation="=") %}
$$
\begin{aligned}
{% for row in rows %}
{{ row.lhs }} &{{ relation }} {{ rhs(row.lines) }}{% if row.origin == "rate_rule" %} \qquad \text{(rate rule)}{% endif %}{{ " \\\\" if not loop.last }}
{% endfor %}
\end{aligned}
$$
{% endmacro %}
{% macro cell(value, kind) %}{% if kind == "check" %}{{ "✓" if value }}{% elif value is none %}{% elif kind == "math" %}${{ value }}${% else %}{{ value }}{% endif %}{% endmacro %}
{#- A table of rows in columns, each column a list of its header, the key of the cells and their kind: text, math or check. -#}
{% macro table(rows, columns) %}
{# a column of names without a name is left out #}
{% set columns = columns if rows | selectattr("name") | list else columns | rejectattr(1, "equalto", "name") | list %}
|{% for c in columns %} {{ c[0] }} |{% endfor +%}
|{% for c in columns %} {{ ":---:" if c[2] == "check" else "---" }} |{% endfor +%}
{% for row in rows %}
|{% for c in columns %} {{ cell(row[c[1]], c[2]) }} |{% endfor +%}
{% endfor %}
{% endmacro %}
