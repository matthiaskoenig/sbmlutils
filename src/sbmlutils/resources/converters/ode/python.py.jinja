{% if options.simulator %}


def simulate(
    t_end: float,
    steps: int = 101,
    p: np.ndarray | None = None,
    x0: np.ndarray | None = None,
    rtol: float = 1e-8,
    atol: float = 1e-10,
    method: str = "LSODA",
) -> pd.DataFrame:
    """Simulate the model from t = 0 to `t_end`.

    Args:
        t_end: the end time
        steps: the number of time points, 0 and `t_end` included
        p: the constants, `P0` if not given
        x0: the initial states, those of `initial_values` if not given
        rtol: the relative tolerance of the integration
        atol: the absolute tolerance of the integration
        method: the method of `scipy.integrate.solve_ivp`

    Returns:
        the time, the states and the assigned values at the time points
    """
    x_initial, p = initial_values(p)
    x0 = x_initial if x0 is None else np.array(x0, dtype=float)
    times = np.linspace(0.0, t_end, steps)
{% if states %}
    solution = solve_ivp(
        f_dxdt,
        (0.0, t_end),
        x0,
        method=method,
        t_eval=times,
        args=(p,),
        rtol=rtol,
        atol=atol,
    )
    if not solution.success:
        raise RuntimeError(f"The integration failed: {solution.message}")
    xt = solution.y.T
{% else %}
    # the model has no states
    xt = np.zeros((steps, 0))
{% endif %}
    yt = np.array([f_y(t, x, p) for t, x in zip(times, xt, strict=True)])
    data = np.column_stack([times, xt, yt.reshape(steps, len(YIDS))])
    return pd.DataFrame(data, columns=["time", *XIDS, *YIDS])


if __name__ == "__main__":
    print(simulate(t_end=10.0).head())
{% endif %}
