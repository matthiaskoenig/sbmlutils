def first_change(
    interpolant: DenseOutput,
    t_old: float,
    t_new: float,
    p: np.ndarray,
    holds: np.ndarray,
) -> float:
    """The first time in a step of the integration at which a trigger changes.

    Bisection on the solution of the step, between a time without and a time with
    a change, finds the first time with a change to the rounding error:
    `time >= 1` changes at t = 1. A trigger which keeps its value at its root and
    changes right after it, `time > 1` at t = 1, changes at a time clearly after
    the root, as an integrator locates it, so that the time stays after the root
    when a delay is added to it.

    Args:
        interpolant: the solution of the step
        t_old: the start of the step, where the triggers are `holds`
        t_new: the end of the step, where a trigger differs from `holds`
        p: the constants
        holds: whether each trigger holds at the start of the step

    Returns:
        the time of the change
    """

    def changed(t: float) -> bool:
        return bool(np.any(event_conditions(t, interpolant(t), p) != holds))

    t_low, t_high = t_old, t_new
    while True:
        t_middle = t_low + (t_high - t_low) / 2
        if t_middle <= t_low or t_middle >= t_high:
            break
        if changed(t_middle):
            t_high = t_middle
        else:
            t_low = t_middle
    turned = event_conditions(t_high, interpolant(t_high), p) != holds
    if np.any(event_triggers(t_low, interpolant(t_low), p)[turned] == 0):
        return min(t_new, t_low + 1e-13 * max(1.0, abs(t_low)))
    return t_high


def change_in_step(
    interpolant: DenseOutput,
    t_old: float,
    t_new: float,
    p: np.ndarray,
    holds: np.ndarray,
) -> float | None:
    """The first time in a step of the integration at which a trigger changes.

    The triggers are evaluated at `TRIGGER_POINTS` points of the step, evenly spaced
    from its start to its end, and the first change between two of them is located by
    `first_change`. A trigger which holds for a shorter time than the distance of the
    points, between two of them, is not seen.

    Args:
        interpolant: the solution of the step
        t_old: the start of the step, where the triggers are `holds`
        t_new: the end of the step
        p: the constants
        holds: whether each trigger holds at the start of the step

    Returns:
        the time of the first change, `None` if no trigger changes
    """
    t_low = t_old
    for t_point in np.linspace(t_old, t_new, TRIGGER_POINTS + 1)[1:]:
        if np.any(event_conditions(t_point, interpolant(t_point), p) != holds):
            return first_change(interpolant, t_low, t_point, p, holds)
        t_low = t_point
    return None


def execute_events(
    t: float, x: np.ndarray, p: np.ndarray, holds: np.ndarray, pending: list[dict]
) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """Execute the events due at the time t.

    1. A trigger which turned true schedules an execution of its event at t plus
       its delay, with the values of its assignments if it uses the values from
       the trigger time; a trigger which turned false drops the executions of its
       event unless it is persistent.
    2. Of the executions due, the one of the highest priority is executed (an
       event without a priority has the priority 0), ties in the order of
       `EVENTS`, which SBML leaves to chance.
    3. The triggers are evaluated with the new states and constants, repeating
       from step 1 until no execution is due: an event can trigger another one or
       drop it. More than `MAX_CASCADE` executions at one time raise.

    Args:
        t: the time
        x: the states
        p: the constants
        holds: whether each trigger held before t
        pending: the scheduled executions, which are changed

    Returns:
        the states, the constants and whether each trigger holds, after the events

    Raises:
        RuntimeError: for more than `MAX_CASCADE` executions, an infinite cascade
    """
    executions = 0
    while True:
        holds_now = event_conditions(t, x, p)
        for event_index, event in enumerate(EVENTS):
            if holds_now[event_index] and not holds[event_index]:
                delay_time = event["delay"](t, x, p) if event["delay"] else 0.0
                if event["use_trigger_values"]:
                    values = event["values"](t, x, p)
                else:
                    values = None
                pending.append(
                    {"event": event_index, "time": t + delay_time, "values": values}
                )
            elif holds[event_index] and not holds_now[event_index]:
                if event["persistent"]:
                    continue
                # the trigger turned false, the executions of the event are dropped
                pending[:] = [
                    scheduled
                    for scheduled in pending
                    if scheduled["event"] != event_index
                ]
        holds = holds_now

        due = [scheduled for scheduled in pending if scheduled["time"] <= t]
        if not due:
            return x, p, holds

        # the priority of each execution due, ties in the order of `EVENTS`
        ranks = []
        for scheduled in due:
            event = EVENTS[scheduled["event"]]
            priority_value = event["priority"](t, x, p) if event["priority"] else 0.0
            ranks.append((priority_value, -scheduled["event"]))
        execution = due[ranks.index(max(ranks))]
        executions += 1
        if executions > MAX_CASCADE:
            raise RuntimeError(
                f"More than {MAX_CASCADE} events were executed at t = {t}, the "
                "events trigger each other in an infinite cascade."
            )
        # by identity: the values of two executions do not compare as booleans
        pending[:] = [scheduled for scheduled in pending if scheduled is not execution]
        event = EVENTS[execution["event"]]
        values = execution["values"]
        if values is None:
            values = event["values"](t, x, p)
        x, p = event["assign"](t, x, p, values)
{% endif %}
{% if options.simulator %}


def simulate(
    t_end: float,
    points: int = 101,
    p: np.ndarray | None = None,
    x0: np.ndarray | None = None,
    rtol: float = 1e-8,
    atol: float = 1e-10,
    method: str = "LSODA",
    max_step: float | None = None,
    max_steps: int | None = None,
) -> pd.DataFrame:
{% if events %}
    """Simulate the model from t = 0 to `t_end`, with its events.

    The triggers before t = 0 have their initial values, a trigger which holds at
    t = 0 and has the initial value false fires at t = 0. The integration stops
    where a trigger changes, at the execution of a delayed event and at `t_end`;
    there the events are executed, see `execute_events`, and the integration
    restarts with the states and constants after them.

    The triggers are evaluated at `TRIGGER_POINTS` points of every step of the
    integrator, which is at most `max_step`, see `change_in_step`: a trigger which
    holds for a shorter time than the distance of these points can be stepped over.
    A time point at a delayed execution, to the rounding of the time (1e-14
    relative), has the values after it: the rounding errors of the integration shift
    the time of the trigger, not its integration error.
{% else %}
    """Simulate the model from t = 0 to `t_end`.
{% endif %}

    Args:
        t_end: the end time
        points: the number of time points, 0 and `t_end` included
        p: the constants, `P0` if not given
        x0: the initial states, those of `initial_values` if not given
        rtol: the relative tolerance of the integration
        atol: the absolute tolerance of the integration
        method: the integrator, a class of `scipy.integrate`, e.g. `"BDF"`
        max_step: the largest step of the integrator, by default the distance of
            the time points
        max_steps: the largest number of steps of the integrator, by default
            `MAX_STEPS` plus twice the number of steps `max_step` forces

    Returns:
{% if event_constants %}
        the time, the states, the assigned values and the constants which events
        change at the time points, at the time of an event the values after it
{% elif events %}
        the time, the states and the assigned values at the time points, at the
        time of an event the values after it
{% else %}
        the time, the states and the assigned values at the time points
{% endif %}

    Raises:
        RuntimeError: if the integration fails, takes more than `max_steps` steps
            or its step is too small to advance the time, e.g. when a state grows
            without bound{% if events %}, and for an infinite cascade of events{% endif %}

    """
    x_initial, p = initial_values(p)
    x = x_initial if x0 is None else np.array(x0, dtype=float)
    times = np.linspace(0.0, t_end, points)
    if max_step is None:
        max_step = times[1] if points > 1 and t_end > 0 else np.inf
    if max_steps is None:
        max_steps = MAX_STEPS + 2 * int(np.ceil(t_end / max_step))
    solver_type = getattr(scipy.integrate, method)  # e.g. scipy.integrate.LSODA
    rows = []  # the states and the constants at each time point
    steps = 0  # the steps of the integrator

    t = 0.0
{% if events %}
    holds = np.array([event["initial_value"] for event in EVENTS])
    pending = []  # the scheduled executions of the events
    x, p, holds = execute_events(t, x, p, holds, pending)
{% endif %}
    while t < t_end:
{% if events %}
        # integrate to the next execution of a delayed event, at most to t_end
        t_stop = min([t_end, *(scheduled["time"] for scheduled in pending)])
{% else %}
        t_stop = t_end
{% endif %}
{% if not states %}
        # without states the integrator takes a single step: the time is
        # integrated in the steps the integrator takes with states
        t_stop = min(t_stop, t + max_step)
{% endif %}
        solver = solver_type(
            partial(f_dxdt, p=p), t, x, t_stop, rtol=rtol, atol=atol, max_step=max_step
        )
        while True:
            solver.step()
            steps += 1
            if solver.status == "failed":
                raise RuntimeError(f"The integration failed: {solver.message}")
            if steps > max_steps:
                raise RuntimeError(
                    f"The integration took more than {max_steps} steps, at t = "
                    f"{solver.t}."
                )
            step_size = solver.t - solver.t_old
            if solver.status == "running" and step_size <= 4 * np.spacing(solver.t):
                raise RuntimeError(
                    f"The step of the integration is too small to advance the time "
                    f"at t = {solver.t}, a state may grow without bound."
                )
            interpolant = solver.dense_output()
{% if events %}
            # the integration stops at the change of a trigger
            t_change = change_in_step(interpolant, solver.t_old, solver.t, p, holds)
            changed = t_change is not None
            t_next = solver.t if t_change is None else t_change
            # the time points of the step before t_next, at t_next after its events; a
            # time point at the end of the integration (a delayed execution) to the
            # rounding of the time is at it, the execution is shifted by the rounding
            # errors of the integration of its trigger, e.g. by 1e-14 at t = 3.4
            t_points = t_next
            if not changed and solver.status == "finished":
                t_points -= 1e-14 * max(1.0, abs(t_next))
            while len(rows) < points and times[len(rows)] < t_points:
                rows.append((interpolant(times[len(rows)]), p))
            if changed or solver.status == "finished":
                break
        t, x = t_next, interpolant(t_next)
        x, p, holds = execute_events(t, x, p, holds, pending)
    # the time points at t_end, after its events
{% else %}
            # the time points of the step
            while len(rows) < points and times[len(rows)] < solver.t:
                rows.append((interpolant(times[len(rows)]), p))
            if solver.status == "finished":
                break
        t, x = solver.t, solver.y
    # the time points at t_end
{% endif %}
    rows.extend((x, p) for _ in range(points - len(rows)))

    xt = np.array([x for x, _ in rows]).reshape(points, len(XIDS))
    yt = np.array([f_y(t, x, p) for t, (x, p) in zip(times, rows, strict=True)])
{% if event_constants %}
    # the constants which events change
    pt = np.array([p[{{ wrapped(event_constants | map(attribute="index") | list, 4, 21, 19) }}] for _, p in rows])
    data = np.column_stack([times, xt, yt.reshape(points, len(YIDS)), pt])
    columns = [
        "time", *XIDS, *YIDS,
{% for c in event_constants %}
        "{{ c.id }}",
{% endfor %}
    ]
    return pd.DataFrame(data, columns=columns)
{% else %}
    data = np.column_stack([times, xt, yt.reshape(points, len(YIDS))])
    return pd.DataFrame(data, columns=["time", *XIDS, *YIDS])
{% endif %}


if __name__ == "__main__":
    print(simulate(t_end=10.0).head())
{% endif %}
