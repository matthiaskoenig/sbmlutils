#
# Returns a list of the initial states x0 and the constants p, named vectors.
initial_values <- function(p = P0) {
  p <- as.numeric(p)
{% set scope = scopes.initial %}
{% if scope.time %}
  t <- 0  # the initial time
{% endif %}
{% if scope.constants %}
  # constants
{% for c in scope.constants %}
  {{ c.code }} <- p[[{{ c.index }}]]{{ comment(c.comment) }}
{% endfor %}
{% endif %}
{% if scope.assignments %}
  # initial values
{% for a in scope.assignments %}
  {{ a.code }} <- {{ a.expr }}{{ comment(a.comment) }}
{% endfor %}
{% endif %}
{% if scope.computed %}
  # the constants set by the initial values
{% for c in scope.computed %}
  p[[{{ c.index }}]] <- {{ c.code }}
{% endfor %}
{% endif %}
{% if states %}
  x0 <- as.numeric({{ wrapped(states | map(attribute="code") | list, 2, 19, 1, 88, ("c(", ")"), False) }})
{% else %}
  x0 <- numeric(0)
{% endif %}
  names(x0) <- XIDS
  names(p) <- PIDS
  list(x0 = x0, p = p)
}

# The rates of change dx/dt of the states x at the time t, in a list (deSolve).
f_dxdt <- function(t, x, p) {
{% set text = body(scopes.dxdt) | trim("\n") %}
{% if text %}
{{ text }}
{% endif %}
  # rates of change
  dx <- numeric({{ odes | length }})
{% for ode in odes %}
  dx[[{{ ode.index }}]] <- {{ ode.expr }}  # d{{ ode.id }}/dt
{% endfor %}
  list(dx)
}

# The assigned values y at the time t, the rules and the reaction rates.
f_y <- function(t, x, p) {
{% set text = body(scopes.y) | trim("\n") %}
{% if text %}
{{ text }}
{% endif %}
{% if assigned %}
  as.numeric({{ wrapped(assigned | map(attribute="code") | list, 2, 13, 1, 88, ("c(", ")"), False) }})
{% else %}
  numeric(0)
{% endif %}
}
{% if events %}

# The root function of the trigger of each event, positive where it holds.
#
# An integrator locates the time at which a trigger changes as a root of its
# function. At a root, where the function is 0, the trigger itself decides, see
# `event_conditions`: `a >= b` holds at `a == b`, `a > b` does not.
event_triggers <- function(t, x, p) {
{% set text = body(scopes.roots) | trim("\n") %}
{% if text %}
{{ text }}
{% endif %}
  as.numeric(c(
{% for e in events %}
    {{ e.root }}{{ "" if loop.last else "," }}  # {{ e.id }}{% if e.comment %} {{ e.comment }}{% endif %}

{% endfor %}
  ))
}

# Whether the trigger of each event holds.
event_conditions <- function(t, x, p) {
{% set text = body(scopes.triggers) | trim("\n") %}
{% if text %}
{{ text }}
{% endif %}
  c(
{% for e in events %}
    {{ e.trigger }}{{ "" if loop.last else "," }}  # {{ e.id }}{% if e.comment %} {{ e.comment }}{% endif %}

{% endfor %}
  )
}
{% for e in events %}
{% if e.delay is not none %}

