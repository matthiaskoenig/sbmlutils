{% endif %}
{{ e.functions.assign }} <- function(t, x, p, values) {
{% set text = body(e.scopes.assign) | trim("\n") %}
{% if text %}
{{ text }}
{% endif %}
{% for a in e.assignments %}
{% set value = "values[[%d]]" % loop.index %}
{% if a.expr is none %}
{% set value = a.scale %}
{% elif a.scale is not none %}
{% set value = value ~ " * " ~ a.scale %}
{% endif %}
{% if a.divisor_position is not none %}
{% set value = value ~ " / values[[%d]]" % (a.divisor_position + 1) %}
{% endif %}
  {{ "x" if a.kind == "state" else "p" }}[[{{ a.index }}]] <- {{ value }}  # {{ a.id }}{% if a.comment %} {{ a.comment }}{% endif %}

{% endfor %}
