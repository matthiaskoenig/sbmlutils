{% for line in text.splitlines() %}
#{{ " " ~ line if line else "" }}
{% endfor %}
{% endmacro %}
{% macro body(scope) %}
{% if scope.states %}
  # states
{% for x in scope.states %}
  {{ x.code }} <- x[[{{ x.index }}]]{{ comment(x.comment) }}
{% endfor %}
{% endif %}
{% if scope.constants %}
  # constants
{% for c in scope.constants %}
  {{ c.code }} <- p[[{{ c.index }}]]{{ comment(c.comment) }}
{% endfor %}
{% endif %}
{% if scope.assignments %}
