"""
Autogenerated ODE definition SBML file with sbmlutils (https://github.com/matthiaskoenig/sbmlutils).

    model: {{ model.getId() }}

time: [{{model_units["time"] | single_line}}]
substance: [{{model_units["substance"] | single_line}}]
extent: [{{model_units["extent"] | single_line}}]
volume: [{{model_units["volume"] | single_line}}]
area: [{{model_units["area"] | single_line}}]
length: [{{model_units["length"] | single_line}}]
"""
import math

import numpy as np
import pandas as pd


# -------------------
# ids
# -------------------
xids = [{% for id in xids %}"{{ id }}", {% endfor %}]
pids = [{% for id in pids %}"{{ id }}", {% endfor %}]
yids = [{% for id in yids %}"{{ id }}", {% endfor %}]

# -------------------
# initial conditions
# -------------------
x0 = np.array([
{% for id in xids %}
    {{x0[id] | python_value}},     # [{{ loop.index0 }}] {{ id }} [{{units[id] | single_line}}] {{names[id] | single_line}}{% if x_compartments[id] %} in {{x_compartments[id]}}{% endif %}

{% endfor %}
])

# -------------------
# parameters
# -------------------
p = np.array([
{% for id in pids %}
    {{p[id] | python_value}},     # [{{ loop.index0 }}] {{ id }} [{{units[id] | single_line}}] {{names[id] | single_line}}
{% endfor %}
])


def f_dxdt(x: np.ndarray, t: float, p: np.ndarray) -> np.ndarray:
    """ODE system."""
    {% for id in yids %}
    {{py_names[id]}} = {{y[id]}}  # [{{ loop.index0 }}] {{ id }} [{{units[id] | single_line}}] {{names[id] | single_line}}
    {% endfor %}

    # ode
    return np.array([
        {% for id in xids %}
        {{dx[id]}},  # [{{ loop.index0 }}] {{ id }} [{{units[id] | single_line}}] {{names[id] | single_line}}
        {% endfor %}
    ])


def f_y(x: np.ndarray, t: float, p: np.ndarray) -> np.ndarray:
    """Calculate y.

    :param x: state vector
    :param t: time
    :param p: parameter vector
    :return:
    """

    {% for id in yids %}
    {{py_names[id]}} = {{y[id]}}  # [{{ loop.index0 }}] {{ id }}  [{{units[id] | single_line}}] {{names[id] | single_line}}
    {% endfor %}

    # --------------------------------------

    y = np.empty(shape=({{yids | length}}))
    {% for id in yids %}
    y[{{loop.index0}}] = {{py_names[id]}}  # [{{ loop.index0 }}] {{ id }}  [{{units[id] | single_line}}] {{names[id] | single_line}}
    {% endfor %}

    return y


def f_z(X: np.ndarray, T: np.ndarray, p: np.ndarray) -> np.ndarray:
    """ DataFrame of full timecourse of solution. """
    (Nt, Nx) = X.shape
    Ny = len(yids)
    Nz = 1 + Nx + Ny
    columns = ["time"] + xids + yids
    Z = np.empty(shape=(Nt, Nz))
    Z[:, 0] = T
    Z[:, 1:(Nx+1)] = X
    for kt in range(Nt):
        y = f_y(x=X[kt, :], t=T[kt], p=p)
        Z[kt, (Nx+1):] = y

    Z = pd.DataFrame(Z, columns=columns)
    return Z
